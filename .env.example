# Copy to .env and fill in. .env is gitignored -- never commit real credentials.

# Dedicated Gmail account for the agent (IMAP + SMTP with an app password)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Gemini API key (https://aistudio.google.com/apikey). Optional: without it the
# agent falls back to a regex request parser.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
